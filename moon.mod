name = "oyjh0381/moonscim"

version = "0.1.0"

readme = "README.md"

repository = "https://github.com/oyjh0381/MoonSCIM"

license = "Apache-2.0"

keywords = [ "scim", "identity", "provisioning", "rfc7643", "rfc7644" ]

preferred_target = "wasm-gc"

description = "Portable SCIM 2.0 schema, filter, patch, query, and bulk semantics for MoonBit"
